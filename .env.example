# Nicolet CZ – Environment Variables
# Copy to .env and fill in production values

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (SQLite – no setup needed)
# DB_PROVIDER=sqlite
# SQLITE_PATH=./backend/nicolet.db   # optional, this is the default

# PRODUCTION (PostgreSQL – Neon / Railway)
# ⚠️  PRODUCTION MUST USE POSTGRESQL. SQLite fallback is BLOCKED.
# ⚠️  If DB_PROVIDER is missing or not "postgres" in production, the app FAILS TO START.
# ⚠️  This prevents data loss from ephemeral SQLite on container restart.
DB_PROVIDER=postgres
DATABASE_URL=postgres://user:password@host/dbname

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3003
# SITE_URL=https://nicoletcz.cz   # Used for sitemap.xml and og:url

# ── Auth ──────────────────────────────────────────────────────────────────────
# CHANGE THIS before deploying to production!
JWT_SECRET=change-this-to-a-long-random-secret

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_MODE=mock
ADMIN_EMAIL=admin@nicoletcz.cz
EMAIL_FROM=noreply@nicoletcz.cz

# SMTP (only needed when EMAIL_MODE=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=password
