true\" data-tab=\"1\" role=\"tab\" tabindex=\"0\" aria-controls=\"popis-aplikace-tab\" aria-expanded=\"false\">\n                            \n                            \n                            \n                                                            <span class=\"eael-tab-title title-after-icon\" >Popis aplikace<\/span>                                                    <\/li>\n                                            <li id=\"ramanova-spektroskopie\" class=\"inactive eael-tab-item-trigger eael-tab-nav-item\" aria-selected=\"false\" data-tab=\"2\" role=\"tab\" tabindex=\"-1\" aria-controls=\"ramanova-spektroskopie-tab\" aria-expanded=\"false\">\n                            \n                            \n                            \n                                                            <span class=\"eael-tab-title title-after-icon\" >Ramanova spektroskopie<\/span>                                                    <\/li>\n                                            <li id=\"ft-ir-spektroskopie\" class=\"inactive eael-tab-item-trigger eael-tab-nav-item\" aria-selected=\"false\" data-tab=\"3\" role=\"tab\" tabindex=\"-1\" aria-controls=\"ft-ir-spektroskopie-tab\" aria-expanded=\"false\">\n                            \n                            \n                            \n                                                            <span class=\"eael-tab-title title-after-icon\" >FT-IR spektroskopie<\/span>                                                    <\/li>\n                                    <\/ul>\n            <\/div>\n            \n            <div class=\"eael-tabs-content\">\n\t\t        \n                    <div id=\"popis-aplikace-tab\" class=\"clearfix eael-tab-content-item inactive\" data-title-link=\"popis-aplikace-tab\">\n\t\t\t\t        <p>K\u0159em\u00edk deponovan\u00fd na skle nebo na karbidu k\u0159em\u00edku je hojn\u011b vyu\u017e\u00edvan\u00fd p\u0159i v\u00fdrob\u011b fotovoltaick\u00fdch \u010dl\u00e1nk\u016f. Pom\u011br a rozlo\u017een\u00ed amorfn\u00edho a krystalick\u00e9ho k\u0159em\u00edku jsou naprosto z\u00e1sadn\u00ed jejich \u00fa\u010dinnost, a proto je tak\u00e9 nutn\u00e9 m\u00edt k\u00a0dispozici spolehlivou metodu jejich anal\u00fdzy.<\/p><p>Ide\u00e1ln\u00ed technikou pro tento typ m\u011b\u0159en\u00ed je <a href=\"https:\/\/assets.thermofisher.com\/TFS-Assets\/CAD\/Application-Notes\/D16998~.pdf\">Ramanova spektroskopie<\/a>, jeliko\u017e krystalick\u00fd a amorfn\u00ed k\u0159em\u00edk maj\u00ed u\u017e na prvn\u00ed pohled velmi snadno odli\u0161iteln\u00e1 spektra, a tak je jej\u00ed pou\u017eit\u00ed celkem p\u0159\u00edmo\u010dar\u00e9. Pomoc\u00ed Lamert-Beerova z\u00e1kona je nav\u00edc mo\u017en\u00e9 prov\u00e1d\u011bt i kvantitativn\u00ed m\u011b\u0159en\u00ed. Proto\u017ee v\u0161ak hroz\u00ed riziko, \u017ee za pou\u017eit\u00ed p\u0159\u00edli\u0161n\u00e9ho v\u00fdkonu laseru dojde k\u00a0transformaci amorfn\u00edho k\u0159em\u00edku na krystalick\u00fd, je nutn\u00e9 jeho v\u00fdkon regulovat: pr\u00e1v\u011b k\u00a0tomuto lze skv\u011ble vyu\u017e\u00edt mo\u017enost Ramanova mikroskopu <a href=\"https:\/\/nicoletcz.cz\/produkt\/dxr3-mikroskop\/\">Nicolet DXR3<\/a>, jeho\u017e laser lze snadno nastavit na po\u017eadovanou hodnotu.<\/p><figure id=\"attachment_9083\" aria-describedby=\"caption-attachment-9083\" style=\"width: 600px\" class=\"wp-caption aligncenter\"><img fetchpriority=\"high\" decoding=\"async\" class=\"wp-image-9083\" src=\"https:\/\/nicoletcz.cz\/app\/uploads\/2021\/09\/56e9f16c-300x203.png\" alt=\"\" width=\"600\" height=\"405\" srcset=\"https:\/\/nicoletcz.cz\/app\/uploads\/2021\/09\/56e9f16c-300x203.png 300w, https:\/\/nicoletcz.cz\/app\/uploads\/2021\/09\/56e9f16c-768x519.png 768w, https:\/\/nicoletcz.cz\/app\/uploads\/2021\/09\/56e9f16c.png 934w\" sizes=\"(max-width: 600px) 100vw, 600px\" \/><figcaption id=\"caption-attachment-9083\" class=\"wp-caption-text\">P\u00e1sy charakteristick\u00e9 pro krystalick\u00fd a amorfn\u00ed k\u0159em\u00edk<\/figcaption><\/figure><p>\u00a0<\/p><p>Krom\u011b bodov\u00e9ho m\u011b\u0159en\u00ed jednotliv\u00fdch spekter nab\u00edz\u00ed mikroskop Nicolet <a href=\"https:\/\/nicoletcz.cz\/produkt\/dxr3-mikroskop\/\">DXR3<\/a> i <a href=\"https:\/\/nicoletcz.cz\/produkt\/dxr3xi-mikroskop\/\">DXR3xi<\/a> mo\u017enost chemick\u00e9ho mapov\u00e1n\u00ed, kter\u00e9 umo\u017e\u0148uje analyzovat distribuci jednotliv\u00fdch slo\u017eek vzorku. Tak m\u016f\u017eete z\u00edskat nejen informaci o jejich rozlo\u017een\u00ed, ale i o jejich kvantitativn\u00edm zastoupen\u00ed.<\/p><figure id=\"attachment_9085\" aria-describedby=\"caption-attachment-9085\" style=\"width: 600px\" class=\"wp-caption aligncenter\"><img decoding=\"async\" class=\"wp-image-9085\" src=\"https:\/\/nicoletcz.cz\/app\/uploads\/2021\/09\/a1f944e7-300x220.jpg\" alt=\"\" width=\"600\" height=\"440\" srcset=\"https:\/\/nicoletcz.cz\/app\/uploads\/2021\/09\/a1f944e7-300x220.jpg 300w, https:\/\/nicoletcz.cz\/app\/uploads\/2021\/09\/a1f944e7-768x563.jpg 768w, https:\/\/nicoletcz.cz\/app\/uploads\/2021\/09\/a1f944e7.jpg 932w\" sizes=\"(max-width: 600px) 100vw, 600px\" \/><figcaption id=\"caption-attachment-9085\" class=\"wp-caption-text\">T\u0159icetimikronov\u00e1 mapa nap\u0159\u00ed\u010d vzorkem zn\u00e1zor\u0148uj\u00edc\u00ed n\u00e1hlou zm\u011bnu formy k\u0159em\u00edku: \u010derven\u00fd bod reprezentuje oblast krystalick\u00e9 formy, p\u0159i\u010dem\u017e \u010derven\u00e1 barva p\u0159edstavuje maxim\u00e1ln\u00ed intenzitu, zat\u00edmco modr\u00e1 nejni\u017e\u0161\u00ed<\/figcaption><\/figure><figure id=\"attachment_9087\" aria-describedby=\"caption-attachment-9087\" style=\"width: 400px\" class=\"wp-caption aligncenter\"><img decoding=\"async\" class=\"wp-image-9087\" src=\"https:\/\/nicoletcz.cz\/app\/uploads\/2021\/09\/04cab159-136x300.png\" alt=\"\" width=\"400\" height=\"880\" srcset=\"https:\/\/nicoletcz.cz\/app\/uploads\/2021\/09\/04cab159-136x300.png 136w, https:\/\/n